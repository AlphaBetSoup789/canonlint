# Provider: anthropic | ollama | mock
CANONLINT_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CANONLINT_MODEL=claude-sonnet-5
# Optional: low | medium | high | xhigh | max
CANONLINT_EFFORT=medium

# --- Ollama (zero cloud spend) ---
# CANONLINT_PROVIDER=ollama
# CANONLINT_OLLAMA_URL=http://localhost:11434
# CANONLINT_MODEL=llama3.1:8b

# --- Cost guardrails ---
# Abort a run before it starts if the estimate exceeds this many USD.
CANONLINT_MAX_SPEND_USD=5
# Per-million-token price overrides (otherwise taken from the pricing table)
# CANONLINT_PRICE_INPUT_PER_MTOK=3
# CANONLINT_PRICE_OUTPUT_PER_MTOK=15
